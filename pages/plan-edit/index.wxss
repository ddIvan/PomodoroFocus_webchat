.edit-page {
  padding-bottom: 60rpx;
}

.field-title {
  display: block;
  margin-top: 36rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pomo-text);
}

.field-title.flush {
  margin: 0;
}

.field-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 36rpx;
  margin-bottom: 8rpx;
}

.field-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pomo-primary);
}

.field-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--pomo-text-second);
  line-height: 1.6;
}

.field-desc.flush {
  margin-top: 4rpx;
}

.field-error {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #d9534f;
}

.input {
  height: 96rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--pomo-divider);
  border-radius: 24rpx;
  background: var(--pomo-surface);
  font-size: 28rpx;
  color: var(--pomo-text);
  box-sizing: border-box;
}

.input-error {
  border-color: #d9534f;
}

.input-ph {
  color: #b9ada6;
}

.textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--pomo-divider);
  border-radius: 24rpx;
  background: var(--pomo-surface);
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--pomo-text);
  box-sizing: border-box;
}

/* ---------------- 分段选择 ---------------- */

.segmented {
  display: flex;
  border: 1rpx solid var(--pomo-divider);
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--pomo-surface);
}

.seg {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--pomo-text-second);
}

.seg-on {
  background: var(--pomo-primary-light);
  color: var(--pomo-primary);
  font-weight: 600;
}

/* ---------------- 星期 ---------------- */

.weekday-row {
  display: flex;
  margin-top: 20rpx;
}

.weekday {
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 1rpx solid var(--pomo-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--pomo-text-second);
  box-sizing: border-box;
}

.weekday-on {
  background: var(--pomo-primary-light);
  border-color: var(--pomo-primary);
  color: var(--pomo-primary);
  font-weight: 600;
}

/* ---------------- 监控默认值 ---------------- */

.monitor-row {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--pomo-divider);
}

.monitor-text {
  margin-right: 16rpx;
}

.monitor-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pomo-text);
}

/* ---------------- 底部 ---------------- */

.save-btn {
  margin-top: 48rpx;
  height: 112rpx;
  border-radius: 36rpx;
  font-size: 32rpx;
}

.delete-link {
  display: block;
  margin-top: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #d9534f;
}
