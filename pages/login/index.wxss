.page {
  min-height: 100vh;
  background: #FFF9F5;
}

.scroll {
  min-height: 100vh;
}

.header {
  padding: 88rpx 56rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  font-size: 112rpx;
  line-height: 1;
}

.app-name {
  margin-top: 22rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #2E2723;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #8C7F77;
}

.card {
  margin: 64rpx 56rpx 0;
  background: #FFFFFF;
  border: 1rpx solid #F1E7E0;
  border-radius: 48rpx;
  padding: 40rpx;
}

.field {
  margin-bottom: 28rpx;
}

.input {
  height: 96rpx;
  border: 1rpx solid #F1E7E0;
  border-radius: 28rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #2E2723;
  background: #FFFFFF;
}

.ph {
  color: #C9BDB5;
}

.pwd-row {
  display: flex;
  align-items: center;
  border: 1rpx solid #F1E7E0;
  border-radius: 28rpx;
  padding-right: 24rpx;
}

.pwd-row .input {
  border: none;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.eye {
  font-size: 26rpx;
  color: #E4572E;
  padding: 8rpx 4rpx;
}

.err {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #C0451F;
}

.btn {
  width: 100%;
  height: 104rpx;
  border-radius: 32rpx;
  font-size: 32rpx;
  line-height: 104rpx;
  text-align: center;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #E4572E;
  color: #FFFFFF;
}

.btn-primary.btn-dim {
  opacity: 0.6;
}

.btn-outline {
  background: transparent;
  color: #E4572E;
  border: 1rpx solid #E4572E;
  font-size: 30rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.agree-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agree-line {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C9BDB5;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.box-on {
  background: #E4572E;
  border-color: #E4572E;
}

.tick {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1;
}

.agree-text {
  font-size: 24rpx;
  color: #8C7F77;
}

.link {
  font-size: 24rpx;
  color: #E4572E;
  padding: 6rpx 0;
}

/* ---------------------------------------------------- 微信登录按钮 */

.wx-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 32rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
  padding: 0;
  margin: 0 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-btn::after {
  border: none;
}

.wx-btn-dim {
  opacity: 0.55;
}

.wx-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  font-size: 26rpx;
  line-height: 48rpx;
  text-align: center;
  margin-right: 14rpx;
}

.wx-text {
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.err {
  margin-top: 20rpx;
}

.api-line {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #B9ACA4;
  word-break: break-all;
}

.footer {
  margin: 48rpx 56rpx 0;
  padding-bottom: 56rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.9;
  color: #8C7F77;
}

.blocked-card {
  padding: 48rpx 40rpx;
}

.blocked-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2E2723;
  text-align: center;
}

.blocked-text {
  margin-top: 24rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: #8C7F77;
}

.mt16 {
  margin-top: 32rpx;
}
