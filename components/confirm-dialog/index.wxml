<view class="mask" wx:if="{{show}}" catchtap="noop" catchtouchmove="noop">
  <view class="dialog" catchtap="noop">
    <view class="title">{{title}}</view>
    <view class="content">{{content}}</view>
    <view class="actions">
      <view class="action cancel" bindtap="onCancel">{{cancelText}}</view>
      <view class="action confirm" bindtap="onConfirm">{{confirmText}}</view>
    </view>
  </view>
</view>
