<view class="mask" wx:if="{{show}}" catchtap="noop" catchtouchmove="noop">
  <view class="dialog" catchtap="noop">
    <view class="title">{{title}}</view>

    <scroll-view class="body" scroll-y>
      <view class="field" wx:for="{{fields}}" wx:key="key">
        <view class="field-label">{{item.label}}</view>
        <input
          class="field-input"
          type="text"
          password="{{item.password}}"
          placeholder="{{item.placeholder}}"
          placeholder-class="ph"
          value="{{values[item.key]}}"
          data-key="{{item.key}}"
          bindinput="onInput"
        />
      </view>

      <view class="err" wx:if="{{error}}">{{error}}</view>
    </scroll-view>

    <view class="actions">
      <view class="action cancel" bindtap="onCancel">取消</view>
      <view class="action confirm" bindtap="onConfirm">{{confirmText}}</view>
    </view>
  </view>
</view>
